PORT=3000
# Κλειδί που στέλνει το ERP: Authorization: Bearer <κλειδί>
ERP_API_KEY=change-me
# Endpoint του ERP που δέχεται ενημερώσεις κατάστασης (προαιρετικό)
ERP_WEBHOOK_URL=
# Μυστικό για την υπογραφή HMAC (X-KDS-Signature)
ERP_WEBHOOK_SECRET=
