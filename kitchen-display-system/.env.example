PORT=3000
# Φάκελος δεδομένων: βάση, μενού, κρυπτογραφικό κλειδί (στο cloud: το μόνιμο volume, π.χ. /data)
KDS_DATA_DIR=./data
# PIN του πρώτου διαχειριστή — χρησιμοποιείται μόνο όταν δεν υπάρχει κανένας χρήστης.
# Αν μείνει κενό, δημιουργείται τυχαίο PIN και τυπώνεται στο log της πρώτης εκκίνησης.
KDS_INITIAL_ADMIN_PIN=
# 1 όταν τρέχει πίσω από proxy του cloud (Railway/Render/nginx) — σωστό HTTPS και IP πελάτη
KDS_BEHIND_PROXY=
# Κλειδί που στέλνει το ERP: Authorization: Bearer <κλειδί>
ERP_API_KEY=change-me
# Endpoint του ERP που δέχεται ενημερώσεις κατάστασης (προαιρετικό)
ERP_WEBHOOK_URL=
# Μυστικό για την υπογραφή HMAC (X-KDS-Signature)
ERP_WEBHOOK_SECRET=
# Ζώνη ώρας για τα στατιστικά (στο cloud συνήθως είναι UTC)
TZ=Europe/Athens
